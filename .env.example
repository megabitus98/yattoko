# Example .env for Yattoko. Copy to .env and fill in the required values.
# Modified 2026 by megabitus98 (fork): every variable the code reads, placeholders only
# A blank value (VAR=) means the default. Booleans: true/false/1/0/yes/no.

# --- required ---
# Telegram API ID and hash from my.telegram.org
APP_ID=
APP_HASH=
# Bot token from BotFather
BOT_TOKEN=

# --- access ---
# Comma-separated Telegram IDs, e.g. 123456789.
# Owners are always allowed; with both lists empty nobody is.
OWNER=
AUTHORIZED_USER=

# --- state ---
# Handler threads (default 16)
WORKERS=
# Database and Telegram session file (default /data)
DATA_DIR=
# SQLAlchemy URL (default sqlite:///<DATA_DIR>/ytdlbot.db)
DB_DSN=
# Download scratch, emptied at startup, must not overlap DATA_DIR (default /tmp/ytdlbot)
TMPFILE_PATH=
# Redis host for the sent-files cache; empty: in-process cache, cleared on restart
REDIS_HOST=
# Largest download in MiB (default 2000)
TG_NORMAL_MAX_SIZE=
# Downloads running at once; the rest wait in a queue (default 2)
MAX_PARALLEL_JOBS=
# Bytes all downloads together may keep under TMPFILE_PATH: the scratch volume's size minus a margin
# (default MAX_PARALLEL_JOBS x 4500 MiB)
TMP_BUDGET=
# Seconds one download may take (default 2700)
JOB_TIMEOUT=
# With ENABLE_FFMPEG: videos up to this many seconds get the best picture and are converted to H.264 if needed (default 300)
REENCODE_MAX_SECONDS=
# Comma-separated static public IPs of your own network, e.g. 203.0.113.7; links that resolve to them are refused
OWN_PUBLIC_IPS=

# --- downloads ---
# Audio format preferred for "send as audio" (default m4a)
AUDIO_FORMAT=
# Audio language to prefer, e.g. en; empty: the original track
PREFERRED_AUDIO_LANG=
# Exits yt-dlp tries in order, moving on only when a site blocks the download (default direct):
# direct (no proxy) or http(s) proxy URLs, e.g. direct,http://proxy.example:8080. Secret: proxy URLs may carry credentials
PROXY_EXITS=
# site=exit pairs; a pinned site uses only that exit, e.g. instagram=direct (the exit must be in PROXY_EXITS)
PROXY_PIN=
# One Netscape cookies file per site: instagram.txt, youtube.txt, tiktok.txt, ... (default /cookies)
COOKIES_DIR=
# YouTube only: PO token, see https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
POTOKEN=

# --- feature switches (all default false) ---
# Text without a link searches YouTube
ENABLE_SEARCH=false
# /direct: plain HTTP download of any URL
ENABLE_DIRECT=false
# aria2 for /direct
ENABLE_ARIA2=false
# /spdl: pixeldrain, krakenfiles
ENABLE_SPDL=false
# /stats for owners
ENABLE_STATS=false
# /ytdl in groups
ENABLE_GROUPS=false
# m3u8 links
M3U8_SUPPORT=false

# --- quota and payments, restored from upstream (default false) ---
# Daily free quota per user, more bought with /buy through Telegram payments
ENABLE_VIP=false
# Payment provider token from BotFather, for /buy. Secret
PROVIDER_TOKEN=
# Free downloads per user per day (default 3)
FREE_DOWNLOAD=
# Downloads per US dollar (default 10). Read but unused, as upstream: the /buy prices are fixed
TOKEN_PRICE=

# --- H.264 conversion (upstream's ENABLE_FFMPEG name, default false) ---
# Short videos: best picture up to the quality setting (default 2K), VP9/AV1 converted to H.264 with ffmpeg
ENABLE_FFMPEG=false

# --- restored from upstream, read but unused there and here ---
RCLONE_PATH=
