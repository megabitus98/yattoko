# Example .env for ytdlbot. Copy to .env and fill in the required values.
# Modified 2026 by megabitus98 (fork): every variable the code reads, placeholders only
# A blank value (VAR=) means the default. Booleans: true/false/1/0/yes/no.

# --- required ---
# Telegram API ID and hash from my.telegram.org
APP_ID=
APP_HASH=
# Bot token from BotFather
BOT_TOKEN=

# --- access ---
# Comma-separated Telegram IDs, e.g. 123456789.
# Owners are always allowed; with both lists empty nobody is.
OWNER=
AUTHORIZED_USER=

# --- state ---
# Handler threads (default 16)
WORKERS=
# Database and Telegram session file (default /data)
DATA_DIR=
# SQLAlchemy URL (default sqlite:///<DATA_DIR>/ytdlbot.db)
DB_DSN=
# Download scratch, emptied at startup, must not overlap DATA_DIR (default /tmp/ytdlbot)
TMPFILE_PATH=
# Redis host for the sent-files cache; empty: in-process cache, cleared on restart
REDIS_HOST=
# Largest download in MiB (default 2000)
TG_NORMAL_MAX_SIZE=

# --- downloads ---
# Audio format preferred for "send as audio" (default m4a)
AUDIO_FORMAT=
# Audio language to prefer, e.g. en; empty: the original track
PREFERRED_AUDIO_LANG=
# Proxy for yt-dlp, e.g. http://proxy.example:8080; empty: direct connection
YT_DLP_PROXY=
# YouTube only: yt-dlp cookies-from-browser value, e.g. firefox
BROWSERS=
# YouTube only: PO token, see https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
POTOKEN=

# --- feature switches (all default false) ---
# Text without a link searches YouTube
ENABLE_SEARCH=false
# /direct: plain HTTP download of any URL
ENABLE_DIRECT=false
# aria2 for /direct
ENABLE_ARIA2=false
# /spdl: pixeldrain, krakenfiles, Instagram through an external service
ENABLE_SPDL=false
# /stats for owners
ENABLE_STATS=false
# /ytdl in groups
ENABLE_GROUPS=false
# m3u8 links
M3U8_SUPPORT=false
